{
  "name": "legal-service-rails-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Product-name-neutral backend implementing the legal service delivery rails blueprint.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/bin/api.ts",
    "dev:worker": "tsx watch src/bin/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/api.js",
    "start:worker": "node dist/bin/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "test:concurrency": "vitest run tests/concurrency",
    "check:citizen-dto": "tsx scripts/check-citizen-dto-boundary.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:apply-runtime-role": "tsx scripts/apply-runtime-role.ts",
    "db:validate-credential-constraints": "tsx scripts/validate-credential-constraints.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:citizen-dto && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
