NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://app_owner:change-me@localhost:5432/legal_service_rails
DATABASE_POOL_MAX=10
LOG_LEVEL=info
AUTH_MODE=HEADER
TAXONOMY_CODES=
DISTRICT_FEE_FLOORS_JSON={}

# External capabilities are explicit. Production startup rejects MOCK modes.
CREDENTIAL_DIGILOCKER_MODE=OFF
CREDENTIAL_BAR_MODE=OFF
CREDENTIAL_AIBE_MODE=OFF
CASE_STATUS_MODE=LINK_ONLY
PAYMENTS_MODE=OFF
IVR_MODE=OFF
WHATSAPP_MODE=OFF
INSTITUTIONAL_EXPORT_MODE=LOCAL

# Required only by a configured adapter. No live partner is assumed.
ECOURTS_PUBLIC_URL=https://services.ecourts.gov.in/
PAYMENT_WEBHOOK_SECRET=
EVIDENCE_SIGNING_SECRET=
