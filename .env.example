NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://legal_service_app:change-runtime-password@localhost:5432/legal_service_rails
MIGRATION_DATABASE_URL=postgres://app_owner:change-owner-password@localhost:5432/legal_service_rails
DATABASE_EXPECTED_USER=legal_service_app
RUNTIME_DATABASE_PASSWORD=change-runtime-password
DATABASE_POOL_MAX=10
LOG_LEVEL=info
AUTH_MODE=HEADER
SESSION_TOKEN_PEPPER=
SESSION_TTL_HOURS=720

# Google OAuth identity adapter. LIVE requires SESSION auth mode plus all four values below.
# The session token is delivered to the frontend via the URL fragment of GOOGLE_OAUTH_FRONTEND_URL.
# GOOGLE_OAUTH_REDIRECT_URI must exactly match an authorized redirect URI in Google Cloud Console.
AUTH_GOOGLE_MODE=OFF
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_FRONTEND_URL=
TAXONOMY_CODES=
PROVIDER_INITIAL_STATUS=
PROVIDER_ACTIVE_STATUSES=
DISTRICT_FEE_FLOORS_JSON={}
CREDENTIAL_REVALIDATION_ACTOR_ID=
PUBLIC_STATS_MIN_CELL_SIZE=

# External capabilities are explicit. Production startup rejects MOCK modes. This build has no
# PSP adapter, so PAYMENTS_MODE must remain OFF in every environment.
CREDENTIAL_DIGILOCKER_MODE=OFF
CREDENTIAL_BAR_MODE=OFF
CREDENTIAL_AIBE_MODE=OFF
CASE_STATUS_MODE=LINK_ONLY
PAYMENTS_MODE=OFF
IVR_MODE=OFF
WHATSAPP_MODE=OFF
INSTITUTIONAL_EXPORT_MODE=LOCAL

# Required only by an implemented adapter. No live partner is assumed.
ECOURTS_PUBLIC_URL=https://services.ecourts.gov.in/
EVIDENCE_SIGNING_SECRET=
